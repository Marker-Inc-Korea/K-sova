{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_seed_id", "atoms"],
  "properties": {
    "source_seed_id": {"type": "string", "minLength": 4},
    "atoms": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane", "conflict_form", "specific_issue_ko", "korean_actor",
          "counter_actor", "shared_facts", "korean_position_claim_ko",
          "counter_position_claim_ko", "korean_stake", "decision_object",
          "why_country_divergent", "korean_source_ids", "counter_source_ids",
          "novelty_from_parent_ko"
        ],
        "properties": {
          "lane": {"type": "string", "minLength": 2},
          "conflict_form": {"type": "string", "minLength": 4},
          "specific_issue_ko": {"type": "string", "minLength": 20},
          "korean_actor": {"type": "string", "minLength": 2},
          "counter_actor": {"type": "string", "minLength": 2},
          "shared_facts": {
            "type": "array", "minItems": 2, "maxItems": 5,
            "items": {"type": "string", "minLength": 12}
          },
          "korean_position_claim_ko": {"type": "string", "minLength": 60},
          "counter_position_claim_ko": {"type": "string", "minLength": 60},
          "korean_stake": {"type": "string", "minLength": 20},
          "decision_object": {"type": "string", "minLength": 20},
          "why_country_divergent": {"type": "string", "minLength": 30},
          "korean_source_ids": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {"type": "string", "minLength": 4}
          },
          "counter_source_ids": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {"type": "string", "minLength": 4}
          },
          "novelty_from_parent_ko": {"type": "string", "minLength": 30}
        }
      }
    }
  }
}
