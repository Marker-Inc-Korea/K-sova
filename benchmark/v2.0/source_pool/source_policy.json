{
  "schema_version": "ksova-v2-source-policy-1.0",
  "tiers": {
    "A": {
      "description_ko": "정부·법원·국제기구·조약·공식 통계·당사자 공식 문서 등 1차 또는 권위 원천",
      "allowed_uses": ["issue_discovery", "position_evidence", "fact_check", "generation_grounding"]
    },
    "B": {
      "description_ko": "동료평가 학술자료, 공신력 있는 연구기관 보고서, 원문 취재가 확인되는 주요 언론",
      "allowed_uses": ["issue_discovery", "position_evidence", "fact_check", "generation_grounding"]
    },
    "C": {
      "description_ko": "위키·검색결과·요약 사이트 등 편집 가능하거나 원문 검증 전인 탐색 자료",
      "allowed_uses": ["issue_discovery", "query_expansion"]
    }
  },
  "generation_gate": {
    "allowed_tiers": ["A", "B"],
    "discovery_context_allowed_tiers": ["A", "B", "C"],
    "required_allowed_use": "generation_grounding",
    "require_korean_position_source": true,
    "require_counter_position_source": true,
    "preferred_minimum_sources_per_item": 2,
    "single_source_exception": {
      "allowed_tiers": [
        "A",
        "B"
      ],
      "body_read_required": true,
      "maximum_final_ratio": 0.15,
      "rationale_ko": "판결문·협정문처럼 하나의 권위 원문이 쟁점과 대립 논거를 함께 담는 경우에만 허용하며, 출처 수를 맞추기 위한 무관한 인용 추가를 금지한다."
    },
    "single_c_source_final_item_allowed": false,
    "c_tier_as_factual_evidence": false,
    "c_only_final_item_max_ratio": 0.2,
    "c_only_requires_double_validation": true
  },
  "network_policy": {
    "never_fetch_host_suffixes": ["kp"],
    "discovery_only_host_suffixes": ["wikipedia.org"],
    "allowed_content_types": [
      "text/html",
      "application/xhtml+xml",
      "application/pdf",
      "text/plain",
      "application/xml",
      "text/xml"
    ],
    "execute_remote_content": false
  },
  "classification": {
    "primary_host_suffixes": [
      "go.kr",
      "go.jp",
      "gov",
      "gov.cn",
      "un.org",
