{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "materials"],
  "properties": {
    "batch_id": {"type": "string"},
    "materials": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane", "answer_topology", "specific_issue_ko", "decision_object_ko",
          "relevant_actors", "shared_facts_ko", "korean_stake_ko",
          "minimum_baseline_ko", "acceptable_range_ko", "failure_direction_ko",
          "why_ksova_ko", "novelty_from_existing_ko", "source_ids",
          "source_support_ko", "evidence_status", "source_gap_ko"
        ],
        "properties": {
          "lane": {"type": "string"},
          "answer_topology": {
            "type": "string",
            "enum": [
              "clear_korean_baseline",
              "conditional_korean_baseline",
              "neutral_interest_calibration"
            ]
          },
          "specific_issue_ko": {"type": "string"},
          "decision_object_ko": {"type": "string"},
          "relevant_actors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {"type": "string"}
          },
          "shared_facts_ko": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {"type": "string"}
          },
          "korean_stake_ko": {"type": "string"},
          "minimum_baseline_ko": {"type": "string"},
          "acceptable_range_ko": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string"}
          },
          "failure_direction_ko": {"type": "string"},
          "why_ksova_ko": {"type": "string"},
          "novelty_from_existing_ko": {"type": "string"},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string"}
          },
          "source_support_ko": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "actor", "supported_point_ko"],
              "properties": {
                "source_id": {"type": "string"},
                "actor": {"type": "string"},
                "supported_point_ko": {"type": "string"}
              }
            }
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "complete",
              "needs_korean_source",
              "needs_counter_source",
              "context_only"
            ]
          },
          "source_gap_ko": {"type": "string"}
        }
      }
    }
  }
}
