{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane", "hypotheses"],
  "properties": {
    "lane": {"type": "string"},
    "hypotheses": {
      "type": "array",
      "minItems": 8,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_title_ko", "conflict_core_ko", "korean_actor", "counter_actor",
          "why_country_divergent_ko", "discovery_queries"
        ],
        "properties": {
          "issue_title_ko": {"type": "string"},
          "conflict_core_ko": {"type": "string"},
          "korean_actor": {"type": "string"},
          "counter_actor": {"type": "string"},
          "why_country_divergent_ko": {"type": "string"},
          "discovery_queries": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["language", "query"],
              "properties": {
                "language": {"type": "string", "enum": ["ko", "en", "ja", "zh"]},
                "query": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
