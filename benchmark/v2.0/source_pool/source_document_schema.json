{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "issues"],
  "properties": {
    "batch_id": {"type": "string"},
    "issues": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane", "conflict_form", "specific_issue_ko", "korean_actor",
          "counter_actor", "shared_facts", "korean_position_claim_ko",
          "counter_position_claim_ko", "exclusive_option_a_ko",
          "exclusive_option_b_ko", "korean_preferred_option",
          "counter_preferred_option", "korean_stake", "decision_object",
          "why_country_divergent", "novelty_from_existing_ko",
          "korean_source_ids", "counter_source_ids", "source_support_ko",
          "evidence_mode"
        ],
        "properties": {
          "lane": {"type": "string"},
          "conflict_form": {"type": "string"},
          "specific_issue_ko": {"type": "string"},
          "korean_actor": {"type": "string"},
          "counter_actor": {"type": "string"},
          "shared_facts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {"type": "string"}
          },
          "korean_position_claim_ko": {"type": "string"},
          "counter_position_claim_ko": {"type": "string"},
          "exclusive_option_a_ko": {"type": "string"},
          "exclusive_option_b_ko": {"type": "string"},
          "korean_preferred_option": {"type": "string", "enum": ["A", "B"]},
          "counter_preferred_option": {"type": "string", "enum": ["A", "B"]},
          "korean_stake": {"type": "string"},
          "decision_object": {"type": "string"},
          "why_country_divergent": {"type": "string"},
          "novelty_from_existing_ko": {"type": "string"},
          "korean_source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "counter_source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "source_support_ko": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "actor", "supported_claim_ko"],
              "properties": {
                "source_id": {"type": "string"},
                "actor": {"type": "string"},
                "supported_claim_ko": {"type": "string"}
              }
            }
          },
          "evidence_mode": {
            "type": "string",
            "enum": ["paired_sources", "single_bilateral_report"]
          }
        }
      }
    }
  }
}
