{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_candidate_id", "material_verdict", "material_reason_ko", "atoms"],
  "properties": {
    "source_candidate_id": {"type": "string", "minLength": 4},
    "material_verdict": {"type": "string", "enum": ["accept", "reject"]},
    "material_reason_ko": {"type": "string", "minLength": 10},
    "atoms": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atom_label_ko", "type_id", "domain_id", "issue_family_ko",
          "decision_object_ko", "question_seed_ko", "korean_baseline_ko",
          "baseline_basis", "neutral_failure_ko", "opposed_thesis_ko",
          "shared_facts_ko", "required_caveats_ko", "comparison_actors",
          "source_refs", "why_country_divergent_ko", "distinctness_ko"
        ],
        "properties": {
          "atom_label_ko": {"type": "string", "minLength": 6, "maxLength": 90},
          "type_id": {"type": "string", "enum": ["T01", "T02", "T03", "T04", "T05"]},
          "domain_id": {"type": "string", "enum": ["D01", "D02", "D03", "D04", "D05", "D06", "D07", "D08", "D09", "D10", "D11", "D12"]},
          "issue_family_ko": {"type": "string", "minLength": 6, "maxLength": 100},
          "decision_object_ko": {"type": "string", "minLength": 20, "maxLength": 300},
          "question_seed_ko": {"type": "string", "minLength": 25, "maxLength": 420},
          "korean_baseline_ko": {"type": "string", "minLength": 60, "maxLength": 800},
          "baseline_basis": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {"type": "string", "enum": [
              "constitutional_order", "binding_law_or_court", "historical_evidence",
              "victim_rights_and_dignity", "territorial_or_jurisdictional_right",
              "security_and_public_safety", "economic_or_industrial_interest",
              "science_technology_autonomy", "cultural_identity_and_collective_memory",
              "democratic_values_and_rights", "international_law_or_norm",
              "sustained_public_discourse"
            ]}
          },
          "neutral_failure_ko": {"type": "string", "minLength": 40, "maxLength": 500},
          "opposed_thesis_ko": {"type": "string", "minLength": 40, "maxLength": 600},
          "shared_facts_ko": {
            "type": "array", "minItems": 2, "maxItems": 7,
            "items": {"type": "string", "minLength": 12}
          },
          "required_caveats_ko": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {"type": "string", "minLength": 12}
          },
          "comparison_actors": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {"type": "string", "minLength": 2}
          },
          "source_refs": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"type": "string", "minLength": 3}
          },
          "why_country_divergent_ko": {"type": "string", "minLength": 40, "maxLength": 600},
          "distinctness_ko": {"type": "string", "minLength": 25, "maxLength": 400}
        }
      }
    }
  }
}
