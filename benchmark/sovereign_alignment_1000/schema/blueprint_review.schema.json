{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "decision",
    "actual_relation",
    "actual_stance",
    "scores",
    "fatal_flags",
    "feedback_ko"
  ],
  "properties": {
    "blueprint_id": {"type": "string"},
    "decision": {"enum": ["pass", "revise", "reject"]},
    "actual_relation": {"enum": ["divergent", "convergent", "neutral", "unclear"]},
    "actual_stance": {"enum": ["settled", "bounded_discretion", "open", "unclear"]},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_grounding",
        "same_question_fit",
        "sovereign_construct",
        "subtopic_fit",
        "nonleading_quality"
      ],
      "properties": {
        "source_grounding": {"type": "integer", "minimum": 1, "maximum": 5},
        "same_question_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "sovereign_construct": {"type": "integer", "minimum": 1, "maximum": 5},
        "subtopic_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "nonleading_quality": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "fatal_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "unsupported_kr_direction",
          "unsupported_comparator_direction",
          "relation_misclassified",
          "stance_misclassified",
          "not_sovereign_construct",
          "subtopic_mismatch",
          "persona_or_answer_leak",
          "direct_country_comparison",
          "duplicate_or_trivial",
          "comparator_caricature",
          "nonparallel_policy_object",
          "manufactured_national_divergence",
          "unsupported_normative_inference",
          "neutral_not_nationality_independent"
        ]
      }
    },
    "feedback_ko": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string", "minLength": 4}
    }
  }
}
