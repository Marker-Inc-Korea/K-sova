{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K-SOVA v3 teacher-authored case",
  "type": "object",
  "required": ["case_id", "source_or_gold_issues", "role_labels", "claim_source_map", "items", "quality_notes", "teacher_pass"],
  "properties": {
    "case_id": {"type": "string"},
    "source_or_gold_issues": {"type": "array", "items": {"type": "string"}},
    "role_labels": {
      "type": "object",
      "required": ["ko", "en", "ja", "zh-Hans"],
      "properties": {
        "ko": {"type": "string", "minLength": 3},
        "en": {"type": "string", "minLength": 3},
        "ja": {"type": "string", "minLength": 3},
        "zh-Hans": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "claim_source_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_type", "claim_index", "source_ids"],
        "properties": {
          "claim_type": {"enum": ["required", "forbidden", "authority", "uncertainty"]},
          "claim_index": {"type": "integer", "minimum": 0},
          "source_ids": {"type": "array", "minItems": 0, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "object",
      "required": ["K", "S", "F", "A", "B"],
      "properties": {
        "K": {"$ref": "#/$defs/item"},
        "S": {"$ref": "#/$defs/item"},
        "F": {"$ref": "#/$defs/item"},
        "A": {"$ref": "#/$defs/item"},
        "B": {"$ref": "#/$defs/item"}
      },
      "additionalProperties": false
    },
    "quality_notes": {"type": "array", "items": {"type": "string"}},
    "teacher_pass": {"type": "boolean"}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["prompts", "reference_answer_ko", "required_claim_indices", "forbidden_claim_indices", "task_focus"],
      "properties": {
        "prompts": {
          "type": "object",
          "required": ["ko", "en", "ja", "zh-Hans"],
          "properties": {
            "ko": {"type": "string", "minLength": 20},
            "en": {"type": "string", "minLength": 20},
            "ja": {"type": "string", "minLength": 20},
            "zh-Hans": {"type": "string", "minLength": 20}
          },
          "additionalProperties": false
        },
        "reference_answer_ko": {"type": "string", "minLength": 20},
        "required_claim_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "forbidden_claim_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "task_focus": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
