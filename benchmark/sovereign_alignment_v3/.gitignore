# Runtime and model-generated artifacts stay local.
outputs/
*.out
*.err
*.py[cod]
__pycache__/
.pytest_cache/

# Freeze only the final V3 configuration and evaluated item snapshot.
config/*
!config/case_blueprints_v22.json
!config/evaluation_conditions.json
!config/teacher_selection_cases.txt

data/*
!data/pilot_items_v22.jsonl

# Keep aggregate evidence and written feedback, not raw generations or retries.
reports/*
!reports/FINAL_PILOT_REPORT_V22.md
!reports/V3_TO_V4_FEEDBACK.md
!reports/construct_quality_v22.json
!reports/construct_quality_v22.md
!reports/item_difficulty_diagnostics_v22.md
!reports/judge_audit_runtime_v22.md
!reports/judge_audit_v22.json
!reports/judge_audit_v22.md
!reports/model_output_quality_v22.json
!reports/model_output_quality_v22.md
!reports/model_validation_v22.json
!reports/model_validation_v22.md
!reports/pilot_items_v22_build.json
!reports/pilot_items_v22_validation.json
!reports/qualitative_model_feedback_v22.md
!reports/source_coverage_v22.json
!reports/source_coverage_v22.md
!reports/source_url_audit_v22.json
!reports/thinking_effect_v22.json
!reports/thinking_effect_v22.md
!reports/v22_critic_consensus_gate.json
!reports/v22_validation_notes.md

# Retain only the Slurm entry points needed to reproduce the final pipeline.
slurm/*
!slurm/eval_calm3.sbatch
!slurm/eval_exaone45.sbatch
!slurm/eval_gemma4.sbatch
!slurm/eval_qwen36.sbatch
!slurm/eval_swallow.sbatch
!slurm/judge_exaone45.sbatch
!slurm/judge_gptoss120.sbatch
!slurm/postprocess_critics_v22.sbatch
!slurm/postprocess_eval_v22.sbatch
!slurm/postprocess_judge_audit_v22_merged.sbatch
!slurm/postprocess_judges_v22_merged.sbatch
!slurm/teacher_select_gptoss120.sbatch

# Keep reusable pipeline tools; one-off repair and retry utilities stay local.
tools/*
!tools/aggregate_evaluation.py
!tools/analyze_judge_audit.py
!tools/audit_construct_quality.py
!tools/audit_model_outputs.py
!tools/build_critic_requests.py
!tools/build_eval_requests.py
!tools/build_judge_audit_sample.py
!tools/build_judge_requests.py
!tools/build_pilot_items.py
!tools/build_teacher_requests.py
!tools/check_source_urls.py
!tools/common.py
!tools/merge_response_outputs.py
!tools/parse_critic_outputs.py
!tools/parse_teacher_outputs.py
!tools/rank_teacher_candidates.py
!tools/report_thinking_effect.py
!tools/run_chat_batch.py
!tools/run_hf_chat_batch.py
!tools/score_judge_outputs.py
!tools/summarize_output_quality.py
!tools/summarize_source_coverage.py
!tools/validate_blueprints.py
!tools/validate_pilot_items.py

tests/*
!tests/test_aggregate_evaluation.py
!tests/test_analyze_judge_audit.py
!tests/test_audit_construct_quality.py
!tests/test_audit_model_outputs.py
!tests/test_build_judge_requests.py
!tests/test_check_source_urls.py
!tests/test_common.py
!tests/test_merge_response_outputs.py
!tests/test_parse_critic_outputs.py
!tests/test_report_thinking_effect.py
!tests/test_score_judge_outputs.py
